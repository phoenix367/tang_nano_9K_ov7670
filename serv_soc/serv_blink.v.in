// ===========================================================================
// AUTO-GENERATED by CMake from serv_blink.v.in -- DO NOT EDIT.
// @SERV_MEMFILE@ is substituted with the absolute path to the firmware hex.
// ===========================================================================
//
// Standalone SERV bring-up for the Tang Nano 9K (GW1NR-9C). Instantiates the
// SERV reference SoC `servant` (the world's smallest RISC-V + RAM + timer +
// 1-bit GPIO) running the `blinky` firmware out of BSRAM, and wires its GPIO
// to an on-board LED. Proves SERV synthesizes + closes timing at 27 MHz and
// that the RISC-V toolchain / BSRAM hex-preload flow work, with ZERO changes
// to the camera design (this is its own Gowin project under serv_soc/).

`default_nettype none
module serv_blink (
    input  wire sys_clk,     // 27 MHz crystal (pin 52)
    input  wire sys_rst_n,   // active-low push-button (pin 4)
    output wire led          // on-board LED (active-low, pin 10)
);
    // Power-on / button reset: hold SERV in reset (active high) for 16 cycles
    // after release so the "MINI" reset strategy and BSRAM preload settle.
    reg        wb_rst  = 1'b1;
    reg [3:0]  rst_cnt = 4'd0;
    always @(posedge sys_clk) begin
        if (!sys_rst_n) begin
            rst_cnt <= 4'd0;
            wb_rst  <= 1'b1;
        end else if (rst_cnt != 4'hF) begin
            rst_cnt <= rst_cnt + 4'd1;
            wb_rst  <= 1'b1;
        end else begin
            wb_rst  <= 1'b0;
        end
    end

    wire q;   // SERV GPIO bit; blinky toggles it
    servant #(
        .memfile ("@SERV_MEMFILE@"),
        .memsize (8192)
    ) soc (
        .wb_clk (sys_clk),
        .wb_rst (wb_rst),
        .q      (q)
    );

    assign led = ~q;   // LEDs on the Tang Nano 9K are active-low
endmodule
`default_nettype wire

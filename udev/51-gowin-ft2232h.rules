# Tang Nano 9K FT2232H (0403:6010) udev rules.
#
# Channel A (interface 0) = JTAG, used by the Gowin programmer (libftd2xx/D2XX).
# Channel B (interface 1) = UART (the design's uart_tx/uart_rx on pins 17/18).
#
# Install:
#   sudo install -m 644 udev/51-gowin-ft2232h.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   # then replug the cable (a fresh "add" event applies the device-node MODE)
#
# With this in place the programmer (channel A) and the UART (ftdi_sio channel
# B, /dev/ttyGowin) work at the same time.

# Raw USB device node must be read/write for D2XX, otherwise programmer_cli
# reports "Cable failed to open via the channel" (exit 50). Setting MODE on an
# interface match alone does NOT change the device-node permissions D2XX opens.
ACTION=="add", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6010", MODE="0666"

# Interface 0 (JTAG): detach ftdi_sio so libftd2xx can claim channel A.
ACTION=="add", SUBSYSTEM=="usb", ATTRS{idVendor}=="0403", \
    ATTRS{idProduct}=="6010", ATTR{bInterfaceNumber}=="00", \
    RUN+="/bin/sh -c 'echo -n %k > /sys/bus/usb/drivers/ftdi_sio/unbind 2>/dev/null; true'"

# Interface 1 (UART): keep ftdi_sio attached so it enumerates as /dev/ttyUSB*,
# expose a stable /dev/ttyGowin symlink, and make it usable by any user without
# sudo or dialout membership -- MODE=0666 (world rw) plus TAG+="uaccess" (grants
# the logged-in desktop user an ACL on systemd-logind seats).
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6010", \
    ATTRS{bInterfaceNumber}=="01", \
    MODE="0666", GROUP="dialout", SYMLINK+="ttyGowin", TAG+="uaccess"

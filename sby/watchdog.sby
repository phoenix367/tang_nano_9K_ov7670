# Cover-reachability for the health watchdog (src/watchdog.sv) via SBY + an SMT
# solver. The SAFETY invariants (hang stickiness/consistency, arm ordering, by
# k-induction) run under yosys's built-in SAT as `ctest -L formal`
# (formal_watchdog); this .sby confirms the interesting states are reachable so
# that proof isn't vacuous: monitoring arms, a subsystem actually hangs, and the
# blink heartbeat toggles.
#
# Properties + small-parameter instance live in sby/watchdog_formal.sv (src
# stays pristine). Requires an SMT solver on PATH (z3 in this dev env). The depth
# spans the small STARTUP grace + TIMEOUT so a hang is reachable. From repo root:
#     sby -f sby/watchdog.sby

[options]
mode cover
depth 24

[engines]
smtbmc z3

[script]
read_verilog -sv -formal -DSBY_COVER watchdog.sv CDC_Bit_Synchronizer.v watchdog_formal.sv
prep -top watchdog_formal -flatten

# Copied into <workdir>/src/ by basename; watchdog.sv's `include "timescale.v"`
# resolves there, so timescale.v must be listed too.
[files]
src/watchdog.sv
src/timescale.v
FPGADesignElements/CDC_Bit_Synchronizer.v
sby/watchdog_formal.sv

# Cover-reachability for the round-robin arbiter (src/arbiter.v) via SBY + an SMT
# solver. The SAFETY invariants (mutual exclusion + grant/req/enable/select, by
# k-induction) run under yosys's built-in SAT as `ctest -L formal` (formal_arbiter);
# this .sby confirms the interesting states are reachable so that proof isn't
# vacuous: each lane can be granted, and the arbiter hands off between lanes.
#
# Properties are embedded in src/arbiter.v behind `ifdef FORMAL (no separate
# wrapper). width is fixed to 4 via chparam. Requires an SMT solver on PATH (z3 in
# this dev env). From the repo root:  sby -f sby/arbiter.sby

[options]
mode cover
depth 6

[engines]
smtbmc z3

[script]
read_verilog -sv -formal -DFORMAL arbiter.v
chparam -set width 4 arbiter
chparam -set select_width 2 arbiter
prep -top arbiter -flatten

# Copied into <workdir>/src/ by basename; arbiter.v's `include "functions.v"`
# resolves there, so functions.v must be listed too.
[files]
src/arbiter.v
src/functions.v
